    <ItemGroup>
      <None Remove="Patches\.gitkeep" />
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <PropertyGroup>
            <PluginsOutDir>..\..\..\BepInEx\plugins\$(TargetName)</PluginsOutDir>
            <BuildPluginsOutDir>..\Build\BepInEx\plugins\$(TargetName)</BuildPluginsOutDir>
        </PropertyGroup>

        <ItemGroup>
            <BundleFiles Include="$(ProjectDir)Bundles\**\*"
                         Exclude="$(ProjectDir)Bundles\**\*.meta;$(ProjectDir)Bundles\**\*.manifest;$(ProjectDir)Bundles\**\.gitkeep" />
        </ItemGroup>

        <MakeDir Directories="$(PluginsOutDir);$(BuildPluginsOutDir)" />

        <Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFolder="$(PluginsOutDir)" SkipUnchangedFiles="true" />
        <Message Importance="High" Text="[PostBuild] Copied $(TargetName).dll to $(PluginsOutDir)" />

        <Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFolder="$(BuildPluginsOutDir)" SkipUnchangedFiles="true" />
        <Message Importance="High" Text="[PostBuild] Copied $(TargetName).dll to $(BuildPluginsOutDir)" />

        <Copy SourceFiles="@(BundleFiles)" DestinationFolder="$(PluginsOutDir)" SkipUnchangedFiles="true" Condition="'@(BundleFiles)' != ''" />
        <Copy SourceFiles="@(BundleFiles)" DestinationFolder="$(BuildPluginsOutDir)" SkipUnchangedFiles="true" Condition="'@(BundleFiles)' != ''" />
        <Message Importance="High" Text="[PostBuild] Copied bundles (@(BundleFiles->'%(Filename)%(Extension)', ', ')) to $(PluginsOutDir) and $(BuildPluginsOutDir)" Condition="'@(BundleFiles)' != ''" />

        <Message Importance="High" Text="[PostBuild] BepInEx build output: $(PluginsOutDir) and $(BuildPluginsOutDir)" />

        <Exec Command="call &quot;$(ProjectDir)nuget-publish-project.bat&quot; $(PackageId) $(Version)" Condition="'$(Configuration)' == 'Publish'" />
    </Target>
    
</Project>
