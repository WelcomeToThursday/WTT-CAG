    "locales": {
      "en": {
        "name": "Ars Arma AVS MOD.1 plate carrier (A-TACS FG)",
        "shortName": "AVS MOD.1",
        "description": "A first generation version of the modified AVS plate carrier originally designed by Crye Precision and adapted by Ars Arma for Russian military units. Designed to combine the modularity of the original Crye product with the creature-comforts typically offered with Russian plate carriers. Equipped with a pouch setup in assault configuration. Manufactured by Ars Arma."
      }
    },
