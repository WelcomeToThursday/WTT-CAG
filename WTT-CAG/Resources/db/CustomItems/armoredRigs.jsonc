    "locales": {
      "en": {
        "name": "Custom Gear CGPC3 plate carrier (Vz 95)",
        "shortName": "CGPC3",
        "description": "The CGPC3 (Plate Carrier 3) is a Czech-designed modular armor carrier intended for military, law enforcement, and civilian tactical applications. The CGPC3 features a low-profile, ergonomic construction that distributes weight evenly across the shoulders and torso, reducing fatigue during extended operations. Its streamlined design minimizes bulk without sacrificing modularity, allowing operators to carry essential equipment while maintaining freedom of movement in confined spaces, dense terrain, and urban environments. Manufactured by Custom Gear."
      }
    },
