    "locales": {
      "en": {
        "name": "Haley Strategic THORAX plate carrier (Coyote Tan)",
        "shortName": "THORAX",
        "description": "The THORAX is a modular plate carrier developed by Haley Strategic Partners to meet the demands of modern military, law enforcement, and security professionals. Designed with operator comfort and adaptability in mind, it features lightweight construction, integrated cable management, scalable load-bearing options, and compatibility with a wide range of mission-specific equipment. The carrier accommodates standard SAPI and ESAPI armor plates while maintaining a low-profile design suitable for prolonged operations. Coyote Tan version."
      }
    },
