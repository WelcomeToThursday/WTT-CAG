    "locales": {
      "en": {
        "name": "Warrior Assault Systems DCS plate carrier (MultiCam)",
        "shortName": "DCS",
        "description": "The DCS is a British-made modular plate carrier designed for carrying heavy armor and combat equipment. This heavily configured example is fitted with additional arm, collar and groin protection, providing extensive coverage at the cost of mobility and weight. Manufactured by Warrior Assault Systems."

      }
    },
