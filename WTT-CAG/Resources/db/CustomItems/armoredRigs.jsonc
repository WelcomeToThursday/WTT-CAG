    "locales": {
      "en": {
        "name": "IOTV Gen4 TAPS hybrid plate carrier (MultiCam)",
        "shortName": "Gen4 TAPS",
        "description": "The Improved Outer Tactical Vest (IOTV) Gen IV is designed to permit maximum freedom of movement required to assume correct firing positions with the agility to execute and maneuver tasks. Optimal design characteristics ensure the best possible weight distribution of both the ballistic body armor system as well as additional load bearing equipment, thus providing enhanced comfort, wear duration, and mobility. Standard U.S. Army setup with TAPS chest rig."
      }
    },
