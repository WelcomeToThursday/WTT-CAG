    "locales": {
      "en": {
        "name": "Paraclete RAV plate carrier (Olive Drab)",
        "shortName": "RAV",
        "description": "The RAV is a modular armor carrier designed for use by military and special operations units during the early Global War on Terror. It features a distinctive single-point quick-release system that allows for the vest to be rapidly discarded in an emergency. This RAV is setup in an assault configuration. Manufactured by Shekkin Gears. Olive Drab version."
        
      }
    },
